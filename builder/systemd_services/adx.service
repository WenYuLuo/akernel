[Unit]
Description=Agent DX control and data plane
After=network-online.target sandboxd.service
Wants=network-online.target sandboxd.service

[Service]
Type=simple
ExecStartPre=/usr/local/bin/ensure-adx-certs
ExecStart=/usr/local/bin/adx-service run
ExecStop=/usr/local/bin/adx-service stop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120
KillMode=control-group
Delegate=yes
TasksMax=infinity

[Install]
WantedBy=multi-user.target
